# Base URL of the Django backend (no /api/v1 suffix). Server-side only.
# Local: run the backend from ../backend (docker compose up).
API_URL=http://localhost:8000

# Where `npm run api:types` reads the OpenAPI contract from. File path or URL.
# Defaults to the sibling backend checkout; a running server serves it at /api/schema/.
# API_SCHEMA=http://localhost:8000/api/schema/

# --- Deployed (EC2) ---------------------------------------------------------------------------------------------
# The APP_ENV_FILE secret of each GitHub Environment is the full runtime env file; the workflow appends IMAGE.
# ENVIRONMENT must match the environment being deployed (staging | production); the deploy action refuses otherwise.
# ENVIRONMENT=staging
# Public hostname nginx serves and the certbot certificate is issued for.
# SERVER_NAME=staging.priresearch.in
# API_URL=https://api-staging.priresearch.in

# Build time, not runtime: comma-separated https hosts next/image may load from (the staging and production storage
# buckets). Set as the repository variable IMAGE_HOSTS; the image is built once and promoted to production.
# IMAGE_HOSTS=pri-staging.s3.amazonaws.com,pri-prod.s3.amazonaws.com
