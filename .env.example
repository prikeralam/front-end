# Base URL of the Django backend (no /api/v1 suffix). Server-side only.
# Local: run the backend from ../backend (docker compose up).
API_URL=http://localhost:8000

# Where `npm run api:types` reads the OpenAPI contract from. File path or URL.
# Defaults to the sibling backend checkout; a running server serves it at /api/schema/.
# API_SCHEMA=http://localhost:8000/api/schema/
