# Alias names (SERVER_ALIASES in the env file, e.g. www.priresearch.in) redirect permanently to SERVER_NAME.
# Appended to the site by pri-nginx-site (website-backend's deploy/aws/host.yml) once the certificate covers the
# aliases; before that, nginx.redirect.http.conf.template is used.

server {
    listen 80;
    server_name ${SERVER_ALIASES};
    include snippets/acme.conf;

    location / {
        return 301 https://${SERVER_NAME}$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${SERVER_ALIASES};

    ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;

    return 301 https://${SERVER_NAME}$request_uri;
}
